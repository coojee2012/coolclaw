{
  "name": "weather",
  "description": "查询指定城市的天气预报（支持全球城市）",
  "version": "1.0.0",
  "parameters": {
    "city": {
      "type": "string",
      "description": "城市名称，如 '北京', 'Shanghai', 'New York'",
      "required": true
    },
    "days": {
      "type": "integer",
      "description": "预报天数（1-3）",
      "default": 2,
      "required": false
    }
  },
  "dependencies": ["httpx"],
  "entry": "main.py"
}
